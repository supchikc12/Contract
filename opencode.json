{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "timeout": {
      "startup": 120000,
      "catalog": 60000
    },
    "servers": {
      "unity": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "mcpforunityserver",
          "mcp-for-unity",
          "--transport",
          "stdio"
        ]
      }
    }
  }
}
